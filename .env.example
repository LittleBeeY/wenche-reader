AI_PROVIDER=mock
# 可选 provider：mock / openai-compatible / anthropic / gemini
# 或厂商预设：deepseek / openai / kimi / zhipu / qwen / ollama
# 预设会自动带入 API 根地址和默认模型，AI_API_BASE / AI_MODEL 可覆盖。
# 例如 DeepSeek：
# AI_PROVIDER=deepseek
# AI_API_KEY=your_api_key
# AI_API_BASE=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# 例如 Anthropic：
# AI_PROVIDER=anthropic
# AI_API_KEY=your_api_key
# 例如本地 Ollama：
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1
# PORT=3000
# HOST=127.0.0.1
