{
  "name": "wenche-reader",
  "version": "1.0.0",
  "description": "文澈阅读：本地优先、支持划词 AI 解析的深度阅读器",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-reader.ps1",
    "config:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/config-ai.ps1",
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "test:ai": "node --test test/ai-provider.test.js test/selection.test.js test/selection-anchors.test.js test/answer-citations.test.js test/answer-references.test.js test/ai-evaluation.test.js",
    "rss:import-bestblogs": "node scripts/import-bestblogs.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install firefox",
    "release:check": "npm test && npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.12",
    "express": "^4.22.1",
    "mammoth": "^1.8.0",
    "marked": "^18.0.5",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jsdom": "^29.1.1"
  }
}
